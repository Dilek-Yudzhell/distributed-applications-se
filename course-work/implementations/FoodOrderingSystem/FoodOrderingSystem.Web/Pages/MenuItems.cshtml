@page
@model FoodOrderingSystem.Web.Pages.MenuItemsModel

@{
    ViewData["Title"] = "Menu Items";
}

<div class="container mt-5">

    <h1 class="mb-4">Menu Items</h1>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            @Model.ErrorMessage
        </div>
    }

    <!-- ADD MENU ITEM -->

    <div class="card shadow-sm mb-5">

        <div class="card-header bg-dark text-white">
            <h3 class="mb-0">Add Menu Item</h3>
        </div>

        <div class="card-body">

            <form method="post" asp-page-handler="Add">

                <div class="mb-3">

                    <label class="form-label">
                        Restaurant ID
                    </label>

                    <input asp-for="NewItem.RestaurantId"
                           type="number"
                           class="form-control"
                           placeholder="Restaurant ID" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Name
                    </label>

                    <input asp-for="NewItem.Name"
                           class="form-control"
                           placeholder="Menu item name" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Description
                    </label>

                    <input asp-for="NewItem.Description"
                           class="form-control"
                           placeholder="Description" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Price
                    </label>

                    <input asp-for="NewItem.Price"
                           type="number"
                           step="0.01"
                           class="form-control"
                           placeholder="Price" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Category
                    </label>

                    <input asp-for="NewItem.Category"
                           class="form-control"
                           placeholder="Pizza, Burger, Drink..." />

                </div>

                <div class="form-check mb-3">

                    <input asp-for="NewItem.IsAvailable"
                           class="form-check-input" />

                    <label class="form-check-label">
                        Available
                    </label>

                </div>

                <button type="submit"
                        class="btn btn-primary">

                    + Add Menu Item

                </button>

            </form>

        </div>

    </div>


    <!-- MENU ITEM LIST -->

    <h2 class="mb-3">
        Menu Item List
    </h2>

    @if (Model.MenuItems.Any())
    {
        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">

                    <tr>

                        <th>ID</th>

                        <th>Restaurant ID</th>

                        <th>Name</th>

                        <th>Description</th>

                        <th>Price</th>

                        <th>Category</th>

                        <th>Available</th>

                        <th>Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.MenuItems)
                    {
                        <tr>

                            <td>
                                @item.Id
                            </td>

                            <td>
                                @item.RestaurantId
                            </td>

                            <td>
                                <strong>
                                    @item.Name
                                </strong>
                            </td>

                            <td>
                                @item.Description
                            </td>

                            <td>
                                @item.Price.ToString("0.00")
                            </td>

                            <td>
                                @item.Category
                            </td>

                            <td>

                                @if (item.IsAvailable)
                                {
                                    <span class="badge bg-success">
                                        Available
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Unavailable
                                    </span>
                                }

                            </td>

                            <td>

                                <a asp-page="/MenuItems/Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">

                                    Edit

                                </a>

                                <form method="post"
                                      asp-page-handler="Delete"
                                      asp-route-id="@item.Id"
                                      style="display:inline;">

                                    <button type="submit"
                                            class="btn btn-danger btn-sm"
                                            onclick="return confirm('Delete this menu item?');">

                                        Delete

                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else if (string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-info">
            No menu items found.
        </div>
    }

</div>