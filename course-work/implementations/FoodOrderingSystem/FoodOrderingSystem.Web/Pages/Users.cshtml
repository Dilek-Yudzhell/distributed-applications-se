@page
@model FoodOrderingSystem.Web.Pages.UsersModel

@{
    ViewData["Title"] = "Users";
}

<div class="container mt-5">

    <h1 class="mb-4">Users</h1>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            @Model.ErrorMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success">
            @Model.SuccessMessage
        </div>
    }

    <!-- ========================= -->
    <!-- SEARCH USERS -->
    <!-- ========================= -->

    <div class="card mb-4">

        <div class="card-header">
            <strong>Search Users</strong>
        </div>

        <div class="card-body">

            <form method="get">

                <div class="row">

                    <div class="col-md-3">

                        <label class="form-label">
                            First Name
                        </label>

                        <input type="text"
                               name="firstName"
                               class="form-control"
                               value="@Model.SearchFirstName"
                               maxlength="50" />

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            Last Name
                        </label>

                        <input type="text"
                               name="lastName"
                               class="form-control"
                               value="@Model.SearchLastName"
                               maxlength="50" />

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            Sort By
                        </label>

                        <select name="sortBy"
                                class="form-select">

                            <option value="firstname"
                                    selected="@(Model.SortBy == "firstname")">
                                First Name
                            </option>

                            <option value="lastname"
                                    selected="@(Model.SortBy == "lastname")">
                                Last Name
                            </option>

                            <option value="email"
                                    selected="@(Model.SortBy == "email")">
                                Email
                            </option>

                            <option value="registrationdate"
                                    selected="@(Model.SortBy == "registrationdate")">
                                Registration Date
                            </option>

                            <option value="id"
                                    selected="@(Model.SortBy == "id")">
                                ID
                            </option>

                        </select>

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            Page Size
                        </label>

                        <select name="pageSize"
                                class="form-select">

                            <option value="5"
                                    selected="@(Model.PageSize == 5)">
                                5
                            </option>

                            <option value="10"
                                    selected="@(Model.PageSize == 10)">
                                10
                            </option>

                            <option value="20"
                                    selected="@(Model.PageSize == 20)">
                                20
                            </option>

                        </select>

                    </div>

                </div>

                <div class="mt-3">

                    <button type="submit"
                            class="btn btn-primary">
                        Search
                    </button>

                    <a asp-page="/Users"
                       class="btn btn-secondary">
                        Clear
                    </a>

                </div>

            </form>

        </div>

    </div>


    <!-- ========================= -->
    <!-- ADD USER -->
    <!-- ========================= -->

    <div class="card mb-4">

        <div class="card-header">
            <strong>Add User</strong>
        </div>

        <div class="card-body">

            <form method="post"
                  asp-page-handler="Add">

                <div class="row">

                    <div class="col-md-2">

                        <label class="form-label">
                            First Name
                        </label>

                        <input asp-for="NewUser.FirstName"
                               class="form-control"
                               maxlength="50"
                               required />

                        <span asp-validation-for="NewUser.FirstName"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-2">

                        <label class="form-label">
                            Last Name
                        </label>

                        <input asp-for="NewUser.LastName"
                               class="form-control"
                               maxlength="50"
                               required />

                        <span asp-validation-for="NewUser.LastName"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-2">

                        <label class="form-label">
                            Email
                        </label>

                        <input asp-for="NewUser.Email"
                               type="email"
                               class="form-control"
                               maxlength="100"
                               required />

                        <span asp-validation-for="NewUser.Email"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-2">

                        <label class="form-label">
                            Password
                        </label>

                        <input asp-for="NewUser.Password"
                               type="password"
                               class="form-control"
                               minlength="6"
                               maxlength="255"
                               required />

                        <span asp-validation-for="NewUser.Password"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-2">

                        <label class="form-label">
                            Phone
                        </label>

                        <input asp-for="NewUser.Phone"
                               class="form-control"
                               maxlength="20"
                               required />

                        <span asp-validation-for="NewUser.Phone"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <button type="submit"
                        class="btn btn-success mt-3">
                    Add User
                </button>

            </form>

        </div>

    </div>


    <!-- ========================= -->
    <!-- USER LIST -->
    <!-- ========================= -->

    <div class="card">

        <div class="card-header">
            <strong>User List</strong>
        </div>

        <div class="card-body">

            @if (Model.Users.Any())
            {

                <div class="table-responsive">

                    <table class="table table-bordered table-striped">

                        <thead class="table-dark">

                            <tr>

                                <th>ID</th>

                                <th>First Name</th>

                                <th>Last Name</th>

                                <th>Email</th>

                                <th>Phone</th>

                                <th>Registration Date</th>

                                <th>Status</th>

                                <th>Actions</th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var user in Model.Users)
                            {

                                <tr>

                                    <td>
                                        @user.Id
                                    </td>

                                    <td>
                                        @user.FirstName
                                    </td>

                                    <td>
                                        @user.LastName
                                    </td>

                                    <td>
                                        @user.Email
                                    </td>

                                    <td>
                                        @user.Phone
                                    </td>

                                    <td>
                                        @user.RegistrationDate.ToString("dd.MM.yyyy")
                                    </td>

                                    <td>

                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactive
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <!-- EDIT BUTTON -->

                                        <button type="button"
                                                class="btn btn-sm btn-warning"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editModal-@user.Id">
                                            Edit
                                        </button>


                                        <!-- DELETE -->

                                        <form method="post"
                                              asp-page-handler="Delete"
                                              style="display:inline;">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@user.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Are you sure you want to delete this user?');">
                                                Delete
                                            </button>

                                        </form>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>


                <!-- ========================= -->
                <!-- PAGINATION -->
                <!-- ========================= -->

                <div class="d-flex justify-content-center mt-4">

                    @if (Model.PageNumber > 1)
                    {

                        <a class="btn btn-outline-primary me-2"
                           asp-page="/Users"
                           asp-route-page="@(Model.PageNumber - 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-firstName="@Model.SearchFirstName"
                           asp-route-lastName="@Model.SearchLastName"
                           asp-route-sortBy="@Model.SortBy">
                            Previous
                        </a>

                    }


                    <span class="btn btn-primary me-2">
                        Page @Model.PageNumber
                    </span>


                    @if (Model.HasNextPage)
                    {

                        <a class="btn btn-outline-primary"
                           asp-page="/Users"
                           asp-route-page="@(Model.PageNumber + 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-firstName="@Model.SearchFirstName"
                           asp-route-lastName="@Model.SearchLastName"
                           asp-route-sortBy="@Model.SortBy">
                            Next
                        </a>

                    }

                </div>

            }
            else
            {

                <div class="alert alert-info">
                    No users found.
                </div>

            }

        </div>

    </div>

</div>


<!-- ========================= -->
<!-- EDIT MODALS -->
<!-- ========================= -->
@foreach (var user in Model.Users)
{

    <div class="modal fade"
         id="editModal-@user.Id"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog">

            <div class="modal-content">

                <form method="post"
                      asp-page-handler="Edit">

                    <div class="modal-header">

                        <h5 class="modal-title">
                            Edit User #@user.Id
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>

                    </div>


                    <div class="modal-body">

                        <input asp-for="EditUser.Id"
                               type="hidden"
                               value="@user.Id" />


                        <div class="mb-3">

                            <label class="form-label">
                                First Name
                            </label>

                            <input asp-for="EditUser.FirstName"
                                   class="form-control"
                                   value="@user.FirstName"
                                   maxlength="50"
                                   required />

                        </div>


                        <div class="mb-3">

                            <label class="form-label">
                                Last Name
                            </label>

                            <input asp-for="EditUser.LastName"
                                   class="form-control"
                                   value="@user.LastName"
                                   maxlength="50"
                                   required />

                        </div>


                        <div class="mb-3">

                            <label class="form-label">
                                Email
                            </label>

                            <input asp-for="EditUser.Email"
                                   type="email"
                                   class="form-control"
                                   value="@user.Email"
                                   maxlength="100"
                                   required />

                        </div>


                        <div class="mb-3">

                            <label class="form-label">
                                New Password
                            </label>

                            <input asp-for="EditUser.Password"
                                   type="password"
                                   class="form-control"
                                   minlength="6"
                                   maxlength="255" />

                            <small class="text-muted">
                                Leave empty to keep the current password.
                            </small>

                        </div>


                        <div class="mb-3">

                            <label class="form-label">
                                Phone
                            </label>

                            <input asp-for="EditUser.Phone"
                                   class="form-control"
                                   value="@user.Phone"
                                   maxlength="20"
                                   required />

                        </div>


                        <div class="form-check">

                            <input asp-for="EditUser.IsActive"
                                   class="form-check-input"
                                   value="true"
                                   checked="@user.IsActive" />

                            <input type="hidden"
                                   name="EditUser.IsActive"
                                   value="false" />

                            <label class="form-check-label">
                                Active
                            </label>

                        </div>

                    </div>


                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn btn-primary">
                            Save Changes
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

}


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}