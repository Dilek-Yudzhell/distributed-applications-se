@page
@model FoodOrderingSystem.Web.Pages.OrderItemsModel

@{
    ViewData["Title"] = "Order Items";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Order Items</h1>

        <a asp-page="/Index" class="btn btn-secondary">
            Back to Home
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success">
            @Model.SuccessMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            @Model.ErrorMessage
        </div>
    }

    <!-- SEARCH -->

    <div class="card mb-4">
        <div class="card-header">
            <strong>Search and Sort</strong>
        </div>

        <div class="card-body">

            <form method="get">

                <div class="row">

                    <div class="col-md-3">
                        <label class="form-label">
                            Order ID
                        </label>

                        <input type="number"
                               name="SearchOrderId"
                               value="@Model.SearchOrderId"
                               class="form-control"
                               placeholder="Order ID" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">
                            Menu Item ID
                        </label>

                        <input type="number"
                               name="SearchMenuItemId"
                               value="@Model.SearchMenuItemId"
                               class="form-control"
                               placeholder="Menu Item ID" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">
                            Sort By
                        </label>

                        <select name="SortBy"
                                class="form-select">

                            <option value="id"
                                    selected="@(Model.SortBy == "id")">
                                ID
                            </option>

                            <option value="quantity"
                                    selected="@(Model.SortBy == "quantity")">
                                Quantity
                            </option>

                            <option value="unitprice"
                                    selected="@(Model.SortBy == "unitprice")">
                                Unit Price
                            </option>

                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">
                            Page Size
                        </label>

                        <select name="PageSize"
                                class="form-select">

                            <option value="5"
                                    selected="@(Model.PageSize == 5)">
                                5
                            </option>

                            <option value="10"
                                    selected="@(Model.PageSize == 10)">
                                10
                            </option>

                            <option value="20"
                                    selected="@(Model.PageSize == 20)">
                                20
                            </option>

                        </select>
                    </div>

                </div>

                <div class="mt-3">

                    <button type="submit"
                            class="btn btn-primary">
                        Search
                    </button>

                    <a asp-page="/OrderItems"
                       class="btn btn-secondary">
                        Clear
                    </a>

                </div>

            </form>

        </div>
    </div>


    <!-- ADD / EDIT -->

    <div class="card mb-4">

        <div class="card-header">

            @if (Model.EditId.HasValue)
            {
                <strong>Edit Order Item</strong>
            }
            else
            {
                <strong>Add Order Item</strong>
            }

        </div>

        <div class="card-body">

            @if (Model.EditId.HasValue)
            {
                <form method="post"
                      asp-page-handler="Edit">

                    <input type="hidden"
                           name="id"
                           value="@Model.EditId.Value" />

                    <div class="row">

                        <div class="col-md-3">

                            <label class="form-label">
                                Order
                            </label>

                            <select asp-for="Input.OrderId"
                                    asp-items="Model.OrderOptions"
                                    class="form-select">

                                <option value="">
                                    -- Select Order --
                                </option>

                            </select>

                        </div>

                        <div class="col-md-3">

                            <label class="form-label">
                                Menu Item
                            </label>

                            <select asp-for="Input.MenuItemId"
                                    asp-items="Model.MenuItemOptions"
                                    class="form-select">

                                <option value="">
                                    -- Select Menu Item --
                                </option>

                            </select>

                        </div>

                        <div class="col-md-2">

                            <label class="form-label">
                                Quantity
                            </label>

                            <input asp-for="Input.Quantity"
                                   type="number"
                                   min="1"
                                   max="100"
                                   class="form-control" />

                        </div>

                        <div class="col-md-2">

                            <label class="form-label">
                                Unit Price
                            </label>

                            <input asp-for="Input.UnitPrice"
                                   type="number"
                                   min="0.01"
                                   step="0.01"
                                   class="form-control" />

                        </div>

                        <div class="col-md-2">

                            <label class="form-label">
                                Notes
                            </label>

                            <input asp-for="Input.Notes"
                                   class="form-control"
                                   maxlength="250" />

                        </div>

                    </div>

                    <div class="mt-3">

                        <button type="submit"
                                class="btn btn-warning">
                            Update
                        </button>

                        <a asp-page="/OrderItems"
                           class="btn btn-secondary">
                            Cancel
                        </a>

                    </div>

                </form>
            }
            else
            {
                <form method="post">

                    <div class="row">

                        <div class="col-md-3">

                            <label class="form-label">
                                Order
                            </label>

                            <select asp-for="Input.OrderId"
                                    asp-items="Model.OrderOptions"
                                    class="form-select">

                                <option value="">
                                    -- Select Order --
                                </option>

                            </select>

                        </div>

                        <div class="col-md-3">

                            <label class="form-label">
                                Menu Item
                            </label>

                            <select asp-for="Input.MenuItemId"
                                    asp-items="Model.MenuItemOptions"
                                    class="form-select">

                                <option value="">
                                    -- Select Menu Item --
                                </option>

                            </select>

                        </div>

                        <div class="col-md-2">

                            <label class="form-label">
                                Quantity
                            </label>

                            <input asp-for="Input.Quantity"
                                   type="number"
                                   min="1"
                                   max="100"
                                   class="form-control" />

                        </div>

                        <div class="col-md-2">

                            <label class="form-label">
                                Unit Price
                            </label>

                            <input asp-for="Input.UnitPrice"
                                   type="number"
                                   min="0.01"
                                   step="0.01"
                                   class="form-control" />

                        </div>

                        <div class="col-md-2">

                            <label class="form-label">
                                Notes
                            </label>

                            <input asp-for="Input.Notes"
                                   class="form-control"
                                   maxlength="250"
                                   placeholder="Optional" />

                        </div>

                    </div>

                    <div class="mt-3">

                        <button type="submit"
                                class="btn btn-success">
                            Add Order Item
                        </button>

                    </div>

                </form>
            }

        </div>
    </div>


    <!-- LIST -->

    <div class="card">

        <div class="card-header">
            <strong>Order Items List</strong>
        </div>

        <div class="card-body p-0">

            @if (Model.OrderItems.Count == 0)
            {
                <div class="p-4 text-center">
                    No order items found.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover mb-0">

                        <thead>

                            <tr>
                                <th>ID</th>
                                <th>Order ID</th>
                                <th>Menu Item ID</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Notes</th>
                                <th>Actions</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>

                                    <td>
                                        @item.Id
                                    </td>

                                    <td>
                                        @item.OrderId
                                    </td>

                                    <td>
                                        @item.MenuItemId
                                    </td>

                                    <td>
                                        @item.Quantity
                                    </td>

                                    <td>
                                        @item.UnitPrice.ToString("F2")
                                    </td>

                                    <td>
                                        @item.Notes
                                    </td>

                                    <td>

                                        <a asp-page="/OrderItems"
                                           asp-route-editId="@item.Id"
                                           class="btn btn-sm btn-warning">
                                            Edit
                                        </a>

                                        <form method="post"
                                              asp-page-handler="Delete"
                                              style="display:inline;">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Are you sure you want to delete this order item?');">
                                                Delete
                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>


    <!-- PAGINATION -->

    <div class="d-flex justify-content-between align-items-center mt-3">

        <div>
            Page <strong>@Model.Page</strong>
        </div>

        <div>

            @if (Model.Page > 1)
            {
                <a asp-page="/OrderItems"
                   asp-route-SearchOrderId="@Model.SearchOrderId"
                   asp-route-SearchMenuItemId="@Model.SearchMenuItemId"
                   asp-route-SortBy="@Model.SortBy"
                   asp-route-PageSize="@Model.PageSize"
                   asp-route-Page="@(Model.Page - 1)"
                   class="btn btn-outline-primary">
                    Previous
                </a>
            }

            @if (Model.HasNextPage)
            {
                <a asp-page="/OrderItems"
                   asp-route-SearchOrderId="@Model.SearchOrderId"
                   asp-route-SearchMenuItemId="@Model.SearchMenuItemId"
                   asp-route-SortBy="@Model.SortBy"
                   asp-route-PageSize="@Model.PageSize"
                   asp-route-Page="@(Model.Page + 1)"
                   class="btn btn-outline-primary">
                    Next
                </a>
            }

        </div>

    </div>

</div>