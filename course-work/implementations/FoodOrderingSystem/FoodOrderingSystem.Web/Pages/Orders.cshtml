@page
@model FoodOrderingSystem.Web.Pages.OrdersModel

@{
    ViewData["Title"] = "Orders";
}

<div class="container mt-5">

    <h1 class="mb-4">Orders</h1>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            @Model.ErrorMessage
        </div>
    }

    <!-- =====================================================
         SEARCH ORDERS
         ===================================================== -->

    <div class="card mb-4">

        <div class="card-header">
            <strong>Search Orders</strong>
        </div>

        <div class="card-body">

            <form method="get">

                <div class="row">

                    <!-- USER ID -->
                    <div class="col-md-3">

                        <label class="form-label">
                            User ID
                        </label>

                        <input type="number"
                               name="userId"
                               class="form-control"
                               value="@Model.CurrentUserId"
                               min="1" />

                    </div>

                    <!-- STATUS -->
                    <div class="col-md-3">

                        <label class="form-label">
                            Status
                        </label>

                        <input type="text"
                               name="status"
                               class="form-control"
                               placeholder="Pending"
                               value="@Model.CurrentStatus" />

                    </div>

                    <!-- SORT -->
                    <div class="col-md-3">

                        <label class="form-label">
                            Sort By
                        </label>

                        <select name="sortBy"
                                class="form-select">

                            @if (Model.CurrentSortBy == "date")
                            {
                                <option value="date" selected>
                                    Date
                                </option>
                            }
                            else
                            {
                                <option value="date">
                                    Date
                                </option>
                            }

                            @if (Model.CurrentSortBy == "price")
                            {
                                <option value="price" selected>
                                    Price
                                </option>
                            }
                            else
                            {
                                <option value="price">
                                    Price
                                </option>
                            }

                            @if (Model.CurrentSortBy == "status")
                            {
                                <option value="status" selected>
                                    Status
                                </option>
                            }
                            else
                            {
                                <option value="status">
                                    Status
                                </option>
                            }

                        </select>

                    </div>

                    <!-- PAGE SIZE -->
                    <div class="col-md-3">

                        <label class="form-label">
                            Page Size
                        </label>

                        <select name="pageSize"
                                class="form-select">

                            @if (Model.PageSize == 5)
                            {
                                <option value="5" selected>
                                    5
                                </option>
                            }
                            else
                            {
                                <option value="5">
                                    5
                                </option>
                            }

                            @if (Model.PageSize == 10)
                            {
                                <option value="10" selected>
                                    10
                                </option>
                            }
                            else
                            {
                                <option value="10">
                                    10
                                </option>
                            }

                            @if (Model.PageSize == 20)
                            {
                                <option value="20" selected>
                                    20
                                </option>
                            }
                            else
                            {
                                <option value="20">
                                    20
                                </option>
                            }

                        </select>

                    </div>

                </div>

                <div class="mt-3">

                    <button type="submit"
                            class="btn btn-primary">
                        Search
                    </button>

                    <a asp-page="/Orders"
                       class="btn btn-secondary">
                        Clear
                    </a>

                </div>

            </form>

        </div>

    </div>


    <!-- =====================================================
         ADD ORDER
         ===================================================== -->

    <div class="card mb-4">

        <div class="card-header">
            <strong>Add Order</strong>
        </div>

        <div class="card-body">

            <form method="post">

                <div class="row">

                    <!-- USER ID -->
                    <div class="col-md-2">

                        <label class="form-label">
                            User ID
                        </label>

                        <input type="number"
                               name="UserId"
                               class="form-control"
                               value="@Model.UserId"
                               min="1"
                               required />

                    </div>

                    <!-- TOTAL PRICE -->
                    <div class="col-md-2">

                        <label class="form-label">
                            Total Price
                        </label>

                        <input type="number"
                               name="TotalPrice"
                               class="form-control"
                               value="@Model.TotalPrice"
                               step="0.01"
                               min="0.01"
                               required />

                    </div>

                    <!-- STATUS -->
                    <div class="col-md-2">

                        <label class="form-label">
                            Status
                        </label>

                        <select name="Status"
                                class="form-select">

                            @if (Model.Status == "Pending")
                            {
                                <option value="Pending" selected>
                                    Pending
                                </option>
                            }
                            else
                            {
                                <option value="Pending">
                                    Pending
                                </option>
                            }

                            @if (Model.Status == "Preparing")
                            {
                                <option value="Preparing" selected>
                                    Preparing
                                </option>
                            }
                            else
                            {
                                <option value="Preparing">
                                    Preparing
                                </option>
                            }

                            @if (Model.Status == "Delivered")
                            {
                                <option value="Delivered" selected>
                                    Delivered
                                </option>
                            }
                            else
                            {
                                <option value="Delivered">
                                    Delivered
                                </option>
                            }

                            @if (Model.Status == "Cancelled")
                            {
                                <option value="Cancelled" selected>
                                    Cancelled
                                </option>
                            }
                            else
                            {
                                <option value="Cancelled">
                                    Cancelled
                                </option>
                            }

                        </select>

                    </div>

                    <!-- DELIVERY ADDRESS -->
                    <div class="col-md-3">

                        <label class="form-label">
                            Delivery Address
                        </label>

                        <input type="text"
                               name="DeliveryAddress"
                               class="form-control"
                               value="@Model.DeliveryAddress"
                               maxlength="250"
                               required />

                    </div>

                    <!-- ORDER DATE -->
                    <div class="col-md-3">

                        <label class="form-label">
                            Order Date
                        </label>

                        <input type="datetime-local"
                               name="OrderDate"
                               class="form-control"
                               value="@Model.OrderDate.ToString("yyyy-MM-ddTHH:mm")"
                               required />

                    </div>

                </div>

                <button type="submit"
                        class="btn btn-success mt-3">
                    Add Order
                </button>

            </form>

        </div>

    </div>


    <!-- =====================================================
         ORDER LIST
         ===================================================== -->

    <div class="card">

        <div class="card-header">
            <strong>Order List</strong>
        </div>

        <div class="card-body">

            @if (Model.Orders.Any())
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-striped">

                        <thead class="table-dark">

                            <tr>

                                <th>ID</th>

                                <th>User ID</th>

                                <th>Total Price</th>

                                <th>Status</th>

                                <th>Delivery Address</th>

                                <th>Order Date</th>

                                <th>Actions</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var order in Model.Orders)
                            {
                                <tr>

                                    <td>
                                        @order.Id
                                    </td>

                                    <td>
                                        @order.UserId
                                    </td>

                                    <td>
                                        @order.TotalPrice.ToString("0.00")
                                    </td>

                                    <td>

                                        @if (order.Status == "Delivered")
                                        {
                                            <span class="badge bg-success">
                                                Delivered
                                            </span>
                                        }
                                        else if (order.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        }
                                        else if (order.Status == "Preparing")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Preparing
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">
                                                @order.Status
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @order.DeliveryAddress
                                    </td>

                                    <td>
                                        @order.OrderDate.ToString("dd.MM.yyyy HH:mm")
                                    </td>

                                    <td>

                                        <!-- EDIT BUTTON -->

                                        <button type="button"
                                                class="btn btn-sm btn-warning"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editModal-@order.Id">
                                            Edit
                                        </button>

                                        <!-- DELETE -->

                                        <form method="post"
                                              asp-page-handler="Delete"
                                              style="display:inline;">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@order.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Are you sure you want to delete this order?');">
                                                Delete
                                            </button>

                                        </form>

                                    </td>

                                </tr>


                                <!-- =================================================
                                     EDIT MODAL
                                     ================================================= -->

                                <div class="modal fade"
                                     id="editModal-@order.Id"
                                     tabindex="-1"
                                     aria-hidden="true">

                                    <div class="modal-dialog">

                                        <div class="modal-content">

                                            <form method="post"
                                                  asp-page-handler="Edit">

                                                <div class="modal-header">

                                                    <h5 class="modal-title">
                                                        Edit Order #@order.Id
                                                    </h5>

                                                    <button type="button"
                                                            class="btn-close"
                                                            data-bs-dismiss="modal">
                                                    </button>

                                                </div>

                                                <div class="modal-body">

                                                    <!-- ORDER ID -->

                                                    <input type="hidden"
                                                           name="EditId"
                                                           value="@order.Id" />


                                                    <!-- USER ID -->

                                                    <div class="mb-3">

                                                        <label class="form-label">
                                                            User ID
                                                        </label>

                                                        <input type="number"
                                                               name="EditUserId"
                                                               value="@order.UserId"
                                                               class="form-control"
                                                               min="1"
                                                               required />

                                                    </div>


                                                    <!-- TOTAL PRICE -->

                                                    <div class="mb-3">

                                                        <label class="form-label">
                                                            Total Price
                                                        </label>

                                                        <input type="number"
                                                               name="EditTotalPrice"
                                                               value="@order.TotalPrice"
                                                               class="form-control"
                                                               step="0.01"
                                                               min="0.01"
                                                               required />

                                                    </div>


                                                    <!-- STATUS -->

                                                    <div class="mb-3">

                                                        <label class="form-label">
                                                            Status
                                                        </label>

                                                        <select name="EditStatus"
                                                                class="form-select">

                                                            @if (order.Status == "Pending")
                                                            {
                                                                <option value="Pending" selected>
                                                                    Pending
                                                                </option>
                                                            }
                                                            else
                                                            {
                                                                <option value="Pending">
                                                                    Pending
                                                                </option>
                                                            }

                                                            @if (order.Status == "Preparing")
                                                            {
                                                                <option value="Preparing" selected>
                                                                    Preparing
                                                                </option>
                                                            }
                                                            else
                                                            {
                                                                <option value="Preparing">
                                                                    Preparing
                                                                </option>
                                                            }

                                                            @if (order.Status == "Delivered")
                                                            {
                                                                <option value="Delivered" selected>
                                                                    Delivered
                                                                </option>
                                                            }
                                                            else
                                                            {
                                                                <option value="Delivered">
                                                                    Delivered
                                                                </option>
                                                            }

                                                            @if (order.Status == "Cancelled")
                                                            {
                                                                <option value="Cancelled" selected>
                                                                    Cancelled
                                                                </option>
                                                            }
                                                            else
                                                            {
                                                                <option value="Cancelled">
                                                                    Cancelled
                                                                </option>
                                                            }

                                                        </select>

                                                    </div>


                                                    <!-- DELIVERY ADDRESS -->

                                                    <div class="mb-3">

                                                        <label class="form-label">
                                                            Delivery Address
                                                        </label>

                                                        <input type="text"
                                                               name="EditDeliveryAddress"
                                                               value="@order.DeliveryAddress"
                                                               class="form-control"
                                                               maxlength="250"
                                                               required />

                                                    </div>


                                                    <!-- ORDER DATE -->

                                                    <div class="mb-3">

                                                        <label class="form-label">
                                                            Order Date
                                                        </label>

                                                        <input type="datetime-local"
                                                               name="EditOrderDate"
                                                               value="@order.OrderDate.ToString("yyyy-MM-ddTHH:mm")"
                                                               class="form-control"
                                                               required />

                                                    </div>

                                                </div>


                                                <!-- MODAL FOOTER -->

                                                <div class="modal-footer">

                                                    <button type="button"
                                                            class="btn btn-secondary"
                                                            data-bs-dismiss="modal">
                                                        Cancel
                                                    </button>

                                                    <button type="submit"
                                                            class="btn btn-primary">
                                                        Save Changes
                                                    </button>

                                                </div>

                                            </form>

                                        </div>

                                    </div>

                                </div>
                            }

                        </tbody>

                    </table>

                </div>


                <!-- =================================================
                     PAGINATION
                     ================================================= -->

                <div class="d-flex justify-content-center mt-4">

                    @if (Model.CurrentPage > 1)
                    {
                        <a class="btn btn-outline-primary me-2"
                           asp-page="/Orders"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-status="@Model.CurrentStatus"
                           asp-route-userId="@Model.CurrentUserId"
                           asp-route-sortBy="@Model.CurrentSortBy">
                            Previous
                        </a>
                    }

                    <span class="btn btn-primary me-2">
                        Page @Model.CurrentPage
                    </span>

                    <a class="btn btn-outline-primary"
                       asp-page="/Orders"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-status="@Model.CurrentStatus"
                       asp-route-userId="@Model.CurrentUserId"
                       asp-route-sortBy="@Model.CurrentSortBy">
                        Next
                    </a>

                </div>

            }
            else
            {
                <div class="alert alert-info">
                    No orders found.
                </div>
            }

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}